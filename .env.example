# Google Gemini API Key (Required for Gemini translation)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model selection (default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-1.5-flash, gemini-2.0-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Provider: "gemini" (default) or "ollama"
EMOJIFY_PROVIDER=gemini
